<Project Sdk="MSTest.Sdk/4.3.3">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Use the VSTest runner instead of Microsoft.Testing.Platform so IDE test discovery works. -->
        <UseVSTest>true</UseVSTest>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\NetSonar\NetSonar.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\src\NetSonar\Localization\Strings*.resx" Link="Localization\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
